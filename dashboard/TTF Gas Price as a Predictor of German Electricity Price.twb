      <column caption='Model MAE' datatype='real' name='[Calculation_1713086656532482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(ABS([model_error_eur_mwh]))' />
      </column>
      <column caption='Baseline MAE' datatype='real' name='[Calculation_1713086656933891]' role='measure' type='quantitative'>
